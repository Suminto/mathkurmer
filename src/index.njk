---
layout: layouts/base.njk
eleventyComputed:
  title: "{{ pagesContent.home.judul }}"
  description: "{{ pagesContent.home.lede }}"
---
<div class="content-inner">
  <p class="eyebrow">{{ pagesContent.home.eyebrow }}</p>
  <h1 class="page-title">{{ pagesContent.home.judul }}</h1>
  <p class="page-lede">{{ pagesContent.home.lede }}</p>

  <div class="hero-card">
    {{ pagesContent.home.isi | markdown | safe }}
  </div>

  <h2 class="section-heading">Jelajahi Materi per Domain</h2>
  <div class="domain-grid">
    {% for d in domains %}
    <a href="/{{ d.slug }}/" class="domain-card">
      <h3>{{ d.nama }}</h3>
      <p>{{ domainDesc[d.slug].deskripsiSingkat }}</p>
      <span class="domain-card-arrow">Fase A&ndash;F &rarr;</span>
    </a>
    {% endfor %}
  </div>
</div>
